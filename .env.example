# SEED Local Full-Stack Environment Configuration (DO NOT COMMIT REAL SECRETS)
# Copy this file to .env.local and fill in one or more server-side keys to enable
# live multimodal Vision OCR and Server Tutor on http://localhost:4173.

# DeepSeek (Multimodal Vision via deepseek-flash & Tutor)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# Google Gemini (OpenAI-compatible multimodal Vision & Tutor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Multimodal Vision & Tutor failover / primary)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Bearer token to protect /api/wonder/* gateway endpoints
SEED_GATEWAY_TOKEN=
